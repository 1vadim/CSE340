<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

        <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/users" class="btn btn-primary">
                View Registered Users
            </a>
        </p>
    <% } %>

    <h2>My Volunteer Projects</h2>

<% if (volunteerProjects.length > 0) { %>

<ul class="volunteer-list">

<% volunteerProjects.forEach(project => { %>

<li class="list-item">
  <a href="/project/<%= project.project_id %>">
    <%= project.title %>
  </a>

  <a
    href="/project/<%= project.project_id %>/unvolunteer"
    class="btn btn-danger"
  >
    Remove
  </a>
</li>

<% }) %>

</ul>

<% } else { %>

<p>
  You have not volunteered for any projects.
</p>

<% } %>

</main>

<%- include('partials/footer') %>