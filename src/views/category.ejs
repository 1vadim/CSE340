<%- include('partials/header') %>

<main>

  <h1><%= category.name %></h1>

  <h2>Service Projects</h2>

  <ul>
    <% if (projects.length > 0) { %>

      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </li>
      <% }) %>

    <% } else { %>

      <li>No projects found for this category.</li>

    <% } %>
  </ul>

</main>

<%- include('partials/footer') %>