<%- include('partials/header') %>

<main>
  <h1><%= project.title %></h1>
  
  <article class="project-details">
    <p class="description"><strong>Description:</strong> <%= project.description %></p>
    
    <p class="date">
      <strong>Date:</strong> 
      <% 
        const formattedDate = new Date(project.date).toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        });
      %><%= formattedDate %>
    </p>
    
    <p class="location"><strong>Location:</strong> <%= project.location %></p>
    
    <p class="organization">
      <strong>Partner Organization:</strong> 
      <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <p class="categories">
  <strong>Categories:</strong>

  <% if (categories.length > 0) { %>

    <% categories.forEach(category => { %>
      <a
        href="/category/<%= category.category_id %>"
        class="category-tag"
      >
        <%= category.name %>
      </a>
    <% }) %>

  <% } else { %>

    No categories assigned.

  <% } %>
</p>
  </article>
<div class="action-buttons">
  <% if (user && user.role_name === 'admin') { %>
  <a href="/project/<%= project.project_id %>/assign-categories" class="btn btn-secondary">Edit Categories</a>
  <a href="/edit-project/<%= project.project_id %>" class="btn">Edit Project Details</a>
  <% } %>
</div>
</main>

<%- include('partials/footer') %>