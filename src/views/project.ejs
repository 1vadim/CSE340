<%- include('partials/header') %>

<main>
  <h1><%= project.title %></h1>
  
  <article class="project-details">
    <p class="description"><strong>Description:</strong> <%= project.description %></p>
    
    <p class="date">
      <strong>Date:</strong> 
      <% 
        const formattedDate = new Date(project.date).toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        });
      %><%= formattedDate %>
    </p>
    
    <p class="location"><strong>Location:</strong> <%= project.location %></p>
    
    <p class="organization">
      <strong>Partner Organization:</strong> 
      <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
  </article>
</main>

<%- include('partials/footer') %>