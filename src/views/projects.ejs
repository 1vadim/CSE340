<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>
  <h2>Upcoming Service Projects</h2>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <% 
          const formattedDate = new Date(project.date).toLocaleDateString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
          });
        %>
        <strong><%= formattedDate %>:</strong> 
        <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
        <em>(<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</em>
      </li>
    <% }) %>

   </ul>
   <p><a href="/new-project" class="btn btn-success">Add a New Service Project</a></p>
</main>

<%- include('partials/footer') %>
